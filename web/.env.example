# Ask the Strategist + AI Engineer verdicts use an LLM when a key is present.
# Copy this to web/.env.local (gitignored) and set ONE of these. The waterfall
# tries them in order: NVIDIA NIM -> Groq -> Gemini -> Cohere.

# NVIDIA NIM (free tier) — primary. https://build.nvidia.com
NVIDIA_API_KEY=
# NIM_MODEL=meta/llama-3.3-70b-instruct

# LLM fallbacks (optional)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# COHERE_API_KEY=

# Live web search for "current/recent" questions (driver's current team, latest
# season, records). Optional — without a key it falls back to keyless Wikipedia.
# Tried in order: Tavily -> Brave -> Wikipedia.
# TAVILY_API_KEY=     # https://tavily.com  (free tier)
# BRAVE_API_KEY=      # https://brave.com/search/api  (free tier)
