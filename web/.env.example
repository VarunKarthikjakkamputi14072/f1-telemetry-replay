# Ask the Strategist + AI Engineer verdicts use an LLM when a key is present.
# Copy this to web/.env.local (gitignored) and set ONE of these. The waterfall
# tries them in order: NVIDIA NIM -> Groq -> Gemini -> Cohere.

# NVIDIA NIM (free tier) — primary. https://build.nvidia.com
NVIDIA_API_KEY=
# NIM_MODEL=meta/llama-3.3-70b-instruct

# Fallbacks (optional)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# COHERE_API_KEY=
